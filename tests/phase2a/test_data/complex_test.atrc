#!ATRC
# Complex test file with nested variables and advanced features

# Base variables
%BaseVar%=base
%Level1%=%BaseVar%_level1
%Level2%=%Level1%_level2
%Level3%=%Level2%_level3

# Special characters and escaping
%SpecialChars%=Special: !@#$%^&*()
%PathVar%=/path/to/file.txt
%URLVar%=https://example.com/path?param=value

# Multiple variable substitution
%Multi%=%BaseVar% and %Level1% and %Level2%

[ComplexBlock]
NestedKey=%Level3%
MultiKey=%BaseVar%_%Level1%_%Level2%
SpecialKey=%SpecialChars%
PathKey=%PathVar%
URLKey=%URLVar%

[MathBlock]
Addition=1+1=2
Multiplication=2*3=6
Division=10/2=5

[LongTextBlock]
LongText=This is a very long text value that spans multiple concepts and includes various types of content including numbers 12345, special characters !@#$, and references to variables like %BaseVar% and %Level1% to test how the system handles complex content.

# Array-like data
[ArrayBlock]
Array1=value1,value2,value3,value4,value5
Array2=1,2,3,4,5
Array3=true,false,true,false