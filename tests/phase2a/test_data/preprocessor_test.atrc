#!ATRC
# Preprocessor test file with conditionals and platform detection

%OS_VAR%=LINUX

#.IF LINUX
%PlatformVar%=Linux detected
[LinuxBlock]
LinuxKey=This runs on Linux
#.ELIF WINDOWS
%PlatformVar%=Windows detected
[WindowsBlock]
WindowsKey=This runs on Windows
#.ELSE
%PlatformVar%=Unknown platform
[UnknownBlock]
UnknownKey=Unknown platform detected
#.ENDIF

# Nested conditionals
#.IF LINUX
    #.IF UNIX
    %NestedVar%=Linux and Unix
    #.ELSE
    %NestedVar%=Linux but not Unix
    #.ENDIF
#.ENDIF

# Time injection test
%TimeTest%=Current time: %*%

# Error test (commented out to prevent actual errors)
# #.ERROR This is a test error message